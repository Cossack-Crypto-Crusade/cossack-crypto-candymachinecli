{
  "name": "cossack-crypto-candymachinecli",
  "description": "a cli for creating metaplex core nft candy machines",
  "version": "0.0.0",
  "author": "peter clemenko",
  "bin": {
    "cossack-crypto-candymachinecli": "./bin/run.js"
  },
  "bugs": "https://github.com/Cossack-Crypto-Crusade/cossack-crypto-candymachinecli/issues",
  "dependencies": {
    "@oclif/core": "^4",
    "@oclif/plugin-help": "^6",
    "@oclif/plugin-plugins": "^5"
  },
  "devDependencies": {
    "@eslint/compat": "^1",
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4",
    "@types/chai": "^4",
    "@types/mocha": "^10",
    "@types/node": "^18",
    "chai": "^4",
    "eslint": "^9",
    "eslint-config-oclif": "^6",
    "eslint-config-prettier": "^10",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.1",
    "mocha": "^10",
    "oclif": "^4",
    "shx": "^0.3.3",
    "ts-node": "^10",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "homepage": "https://github.com/Cossack-Crypto-Crusade/cossack-crypto-candymachinecli",
  "keywords": [
    "oclif"
  ],
  "license": "mit",
  "main": "dist/index.js",
  "type": "module",
  "oclif": {
    "bin": "cossack-crypto-candymachinecli",
    "dirname": "cossack-crypto-candymachinecli",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins"
    ],
    "topicSeparator": " ",
    "topics": {
      "hello": {
        "description": "Say hello to the world and others"
      }
    }
  },
  "repository": "https://github.com/Cossack-Crypto-Crusade/cossack-crypto-candymachinecli",
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "lint": "eslint . --ext .ts,.js",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "pnpm run lint",
    "prepack": "oclif manifest && oclif readme",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme && git add README.md",
    "typecheck": "tsc --noEmit",
    "precommit": "npm run lint && npm run typecheck && npm run test",
    "prepare": "husky install"
  },
  "types": "dist/index.d.ts",
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
